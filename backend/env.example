# Ollama Configuration (chỉ sử dụng Ollama với deepseek-r1:7b)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=deepseek-r1:7b
OLLAMA_TIMEOUT=120
OLLAMA_MAX_TOKENS=2000

# Server Configuration
HOST=0.0.0.0
PORT=8000

# Embedding Model Configuration
# Force CPU mode (Linux uses CPU by default to avoid CUDA issues)
# Set to "1" to force CPU, "0" to try GPU (not recommended on Linux)
# Mac: automatically uses MPS (Metal), works fine
# Linux: defaults to CPU to avoid CUDA errors
FORCE_CPU=1

# Public IP Configuration (để truy cập từ bên ngoài)
# Tự động lấy IP public khi chạy run.sh, hoặc set thủ công:
# PUBLIC_IP=your_public_ip_here
# CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://your_public_ip_here:3000