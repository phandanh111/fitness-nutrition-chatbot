# AI Provider Configuration
AI_PROVIDER=ollama
# Options: ollama | deepseek

# DeepSeek Configuration (only when AI_PROVIDER=deepseek)
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Ollama Configuration (only when AI_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3:8b

# Server Configuration
HOST=0.0.0.0
PORT=8000

# Public IP Configuration (để truy cập từ bên ngoài)
# Tự động lấy IP public khi chạy run.sh, hoặc set thủ công:
# PUBLIC_IP=your_public_ip_here
# CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://your_public_ip_here:3000